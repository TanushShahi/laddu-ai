# ===================================================================
# LADDU — Universal Personal AI Assistant Configuration (.env)
# ===================================================================
# All cloud settings are optional. If no cloud keys are provided,
# LADDU will automatically operate in 100% free offline mode.
# ===================================================================

# General Settings
PORT=3000
HOST=0.0.0.0
ASSISTANT_NAME=LADDU
WAKE_WORD="Hey Laddu"
DATA_DIR="./data"

# AI Model Provider Selection
# Options: "offline", "ollama", "gemini", "openai_compatible"
AI_PROVIDER=offline

# Local Ollama Provider (100% Free & Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini API (Free Tier available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-Compatible Endpoints (Groq, LM Studio, vLLM, DeepSeek, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Security & Encryption (32-character key for AES-256-GCM memory encryption)
ENCRYPTION_KEY=

# Speech & Voice Settings
VOICE_RATE=1.0
VOICE_PITCH=1.0
VOICE_NAME=""
VOICE_SYSTEM_SPEECH_ENABLED=true

# Guardrails & Permissions
STRICT_PERMISSIONS_ENABLED=true
AUDIT_LOG_ENABLED=true
MAX_EXECUTION_TIMEOUT_MS=30000
